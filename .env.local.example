NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Management API (Operating Costs → Sync Supabase)
# Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_ORG_SLUG=your_org_slug
SUPABASE_PROJECT_REF=your_project_ref

# Pricing backend proxy (https://pricing.vantage-lane.com)
NEXT_PUBLIC_BACKEND_URL=/api/backend-proxy
BACKEND_PROXY_TARGET=https://pricing.vantage-lane.com

# Stripe (pentru payment links)
STRIPE_SECRET_KEY=sk_live_...

# Google Maps (Places Autocomplete în New Job wizard)
# Același key ca în vantage-lane-2.0
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Cloud Billing (Operating Costs sync for Maps / Cloud)
GOOGLE_BILLING_ACCOUNT_ID=XXXXXX-XXXXXX-XXXXXX
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-billing-sa.json
GOOGLE_BILLING_BQ_DATASET=billing_export

# Google Ads (Operating Costs sync)
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# AeroDataBox (API.market) — same key as vantage-lane-2.0 website
# Used for one-shot flight arrival check in Bookings → Flight Info
AERODATABOX_API_KEY=
AERODATABOX_BASE_URL=https://prod.api.market/api/v1/aedbx/aerodatabox
